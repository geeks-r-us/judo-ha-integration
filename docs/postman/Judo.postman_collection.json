                },
                {
                  "key": "ewuid",
                  "value": "{{ewuid}}",
                  "disabled": true
                }
              ]
            },
            "description": "Concrete target-hardness example matching the current integration compatibility path."
          },
          "response": []
        }
      ]
    },
